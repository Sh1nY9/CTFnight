{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctfnight.invalid/schemas/challenge.schema.json",
  "title": "CTFnight challenge-as-code definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_slug",
    "slug",
    "title",
    "category",
    "description_md",
    "scoring",
    "flag"
  ],
  "properties": {
    "event_slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "category": {"type": "string", "minLength": 1, "maxLength": 80},
    "description_md": {"type": "string", "minLength": 1, "maxLength": 100000},
    "connection_info": {"type": ["string", "null"], "maxLength": 2000},
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "initial"],
      "properties": {
        "type": {"enum": ["fixed", "dynamic"]},
        "initial": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "minimum": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "decay": {"type": "integer", "minimum": 1, "maximum": 1000000}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "dynamic"}}},
          "then": {"required": ["minimum", "decay"]}
        }
      ]
    },
    "max_attempts": {"type": "integer", "minimum": 0, "maximum": 1000},
    "visible": {"type": "boolean"},
    "visible_at": {"type": ["string", "null"], "format": "date-time"},
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"enum": ["exact", "regex"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
      "maxItems": 100
    }
  }
}
