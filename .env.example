# CTFnight deployment environment
#
# Do not deploy by copying this file as-is. Generate a mode-0600 .env with:
#   ./scripts/generate-env.sh

# Caddy site address. Use http://localhost for local testing or a DNS name such
# as ctf.example.com for automatic HTTPS.
ALPHA_COMPOSE_PROJECT_NAME=alpha
ALPHA_SITE_ADDRESS=http://localhost
ALPHA_HTTP_PORT=80
ALPHA_HTTPS_PORT=443
ALPHA_BIND_ADDRESS=127.0.0.1
ALPHA_ENVIRONMENT=development

# Application security. Root keys and passwords are mounted from mode-0600
# files under .secrets/ and must never be stored in this environment file.
ALPHA_COOKIE_SECURE=false
ALPHA_ALLOWED_ORIGINS=["http://localhost"]
ALPHA_TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
ALPHA_FORWARDED_ALLOW_IPS=172.31.250.2
ALPHA_SESSION_TTL_HOURS=24
ALPHA_SESSION_CLEANUP_BATCH_SIZE=100
ALPHA_CSRF_TTL_SECONDS=3600
ALPHA_MAX_FLAG_LENGTH=512

# PostgreSQL owner, migrator, runtime and Redis credentials are stored in
# separate .secrets files. Identifiers are not secret. On an existing dedicated
# volume, set ALPHA_POSTGRES_OWNER_USER to the original POSTGRES_USER before the
# first role-provisioning run; initdb environment values do not rewrite volumes.
ALPHA_POSTGRES_DB=alpha
ALPHA_POSTGRES_OWNER_USER=alpha
ALPHA_POSTGRES_MIGRATOR_USER=alpha_migrator
ALPHA_POSTGRES_RUNTIME_USER=alpha_app

# The bootstrap password is read from .secrets/admin_password only when the
# first administrator is created. After changing it at /account/security,
# truncate that file and set ALPHA_ADMIN_BOOTSTRAPPED=true.
ALPHA_ADMIN_EMAIL=admin@example.com
ALPHA_ADMIN_USERNAME=admin
ALPHA_ADMIN_BOOTSTRAPPED=false

# Demo content is opt-in and must remain false for a real event.
ALPHA_SEED_DEMO=false

# Backups fail closed unless an age public recipient is configured.
ALPHA_BACKUP_AGE_RECIPIENT=

# Infrastructure images are immutable, vulnerability-scanned manifest digests.
# Upgrade intentionally after a verified encrypted backup and security scan.
POSTGRES_IMAGE=cgr.dev/chainguard/postgres:latest@sha256:41a02d9c35a8dc6cac36188a0a201528ea8d686bb238af595867252821f609b9
REDIS_IMAGE=cgr.dev/chainguard/redis:latest@sha256:f639a439f5ab4f14486d6c6404f388b9dc076a25f85c6939630f2f805dfad969
